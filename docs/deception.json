  "game_logic_loop": {
    "setup": [
      "Hệ thống chia cho mỗi người chơi (trừ Pháp y) 4 thẻ Manh mối ngẫu nhiên và 4 thẻ Hung khí ngẫu nhiên[cite: 191].",
      "Màn hình của tất cả người chơi chuyển sang trạng thái 'Nhắm mắt' (tối đen)[cite: 192].",
      "Giao diện điện thoại của Kẻ sát nhân mở khóa, cho phép bấm chọn 1 thẻ Hung khí và 1 thẻ Manh mối của chính mình[cite: 193].",
      "Hệ thống gửi gói dữ liệu về hai thẻ này đến màn hình của Nhà Khoa học Pháp y[cite: 194].",
      "Điện thoại của Nhân chứng (nếu có) sẽ hiển thị thông báo chỉ đích danh ai là Kẻ sát nhân và Tòng phạm[cite: 195]."
    ],
    "round_1": [
      "Hệ thống máy chủ tạo ra 6 ô hiện trường trên bàn cờ chung ảo: 2 ô cố định (Nguyên nhân tử vong và Địa điểm gây án) và 4 ô ngẫu nhiên[cite: 197].",
      "Điện thoại của Pháp y cho phép kéo thả 6 viên đạn (marker) vào các dòng thuộc tính trên 6 ô hiện trường này[cite: 198].",
      "Sau khi đạn được đặt, ứng dụng bắt đầu đếm ngược 30 giây cho mỗi điều tra viên trình bày giả thuyết của mình[cite: 199]."
    ],
    "round_2_and_3": [
      "Hệ thống tự động loại bỏ ngẫu nhiên 1 ô hiện trường cũ (trừ ô Nguyên nhân tử vong và Địa điểm gây án) và thay bằng 1 ô hiện trường mới[cite: 200].",
      "Nhà Khoa học Pháp y kéo thả đạn sang dòng thuộc tính mới trên ô vừa xuất hiện[cite: 201].",
      "Hệ thống lặp lại vòng lặp đếm ngược 30 giây cho mỗi người chơi phát biểu[cite: 202].",
      "Trò chơi kết thúc ngay sau lượt trình bày cuối cùng của người chơi cuối cùng ở vòng 3 nếu không ai phá án thành công[cite: 203]."
    ],
    "solving_crime_api": [
      "Mỗi điều tra viên có một nút chức năng 'Huy hiệu' đại diện cho một cơ hội phá án duy nhất[cite: 205].",
      "Khi kích hoạt, người chơi phải bấm chọn 3 đối tượng trên màn hình: 1 Người chơi khác, 1 Hung khí và 1 Manh mối[cite: 206].",
      "Hệ thống gửi dữ liệu đến màn hình Pháp y, Pháp y chỉ có hai nút bấm để phản hồi là 'Đúng' hoặc 'Sai'[cite: 207].",
      "Nếu Pháp y bấm 'Sai' (vì sai dù chỉ một yếu tố), hệ thống sẽ khóa vĩnh viễn nút phá án của người chơi đó, nhưng họ vẫn có quyền ở lại chat và thảo luận[cite: 208].",
      "Trò chơi báo hiệu phe Điều tra viên thắng nếu có người phá án đúng[cite: 209].",
      "Trò chơi báo hiệu phe Hung thủ thắng nếu hết 3 vòng không ai đoán đúng hoặc toàn bộ điều tra viên đã dùng hết quyền phá án và bị sai[cite: 210]."
    ]
  },
